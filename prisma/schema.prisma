generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
}

model Conversation {
  id        String    @id @default(cuid())
  projectId String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([projectId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model SourceFolder {
  id        String        @id @default(cuid())
  path      String        @unique
  label     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  documents Document[]
  jobs      IndexingJob[]
}

model Document {
  id             String       @id @default(cuid())
  sourceFolderId String
  relativePath   String
  fileName       String
  mimeType       String?
  fileSize       Int?
  checksum       String?
  extractedText  String?
  indexedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sourceFolder   SourceFolder @relation(fields: [sourceFolderId], references: [id], onDelete: Cascade)

  @@unique([sourceFolderId, relativePath])
  @@index([sourceFolderId])
}

model IndexingJob {
  id             String       @id @default(cuid())
  sourceFolderId String?
  kind           IndexingKind
  status         JobStatus    @default(QUEUED)
  processedCount Int          @default(0)
  totalCount     Int?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  sourceFolder   SourceFolder? @relation(fields: [sourceFolderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum IndexingKind {
  FULL
  INCREMENTAL
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
