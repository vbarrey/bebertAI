generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model PipelineParameters {
  id        Int      @id @default(1)
  parameters    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                String         @id @default(cuid())
  name              String         @unique
  description       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  conversations     Conversation[]
}

model Conversation {
  id                String    @id @default(cuid())
  projectId         String
  title             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages          Message[]
  lastMessageAt     DateTime @default(now())

  modelId String?
  model   AIModel? @relation(fields: [modelId], references: [id])

  @@index([projectId, lastMessageAt])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String

  role              MessageRole
  status            MessageStatus @default(COMPLETED)

  content           String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum DocumentSourceType {
  LOCAL
  GOOGLE_DRIVE
  DROPBOX
}

model Document {
  id             String         @id @default(uuid())
  displayName    String
  format         String
  fileSize       Int?
  checksum       String         @unique
  language       String?

  sourceType  DocumentSourceType
  sourceRef   String?
  storagePath String?

  indexedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  indexingStatus IndexingStatus @default(UNPLANNED)

  chunks         Chunk[]
  indexingJobs   IndexingJob[]

  @@index([displayName])
}

model Chunk {
  id         String @id @default(cuid())
  documentId String

  position   Int
  text       String

  pageNumber Int?
  x          Float?
  y          Float?
  width      Float?
  height     Float?

  document Document @relation( fields: [documentId], references: [id], onDelete: Cascade )

  @@index([documentId, position])
}

model IndexingJob {
  id         String   @id @default(cuid())
  documentId String

  status       JobStatus @default(QUEUED)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt   DateTime  @default(now())

  document Document @relation( fields: [documentId], references: [id], onDelete: Cascade )

  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

model AIProvider {
  id        String @id @default(cuid())

  name      String
  type      AIProviderType

  enabled   Boolean @default(true)
  isDefault Boolean @default(false)

  configuration Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models        AIModel[] @relation("ProviderModels")

  defaultModelId String?
  defaultModel AIModel? @relation("DefaultModel", fields: [defaultModelId], references: [id])
}

model AIModel {
  id String @id @default(cuid())

  providerId String
  provider AIProvider @relation("ProviderModels", fields: [providerId], references: [id], onDelete: Cascade)

  defaultForProviders AIProvider[] @relation("DefaultModel")

  name String
  displayName String?
  description String?

  enabled Boolean @default(true)
  favorite Boolean @default(false)

  sizeBytes BigInt?
  parameterSize String?
  family String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source AIModelSource

  conversations Conversation[]

  capabilities AIModelCapability[]

  @@unique([providerId, name])
}

model AIModelCapability {
  id String @id @default(cuid())
  name Capability @unique

  models AIModel[]
}

enum Capability {
  GENERATION
  EMBEDDING
  RERANKING
}

enum AIProviderType {
  OLLAMA
  OPENAI
  ANTHROPIC
}

enum AIModelSource {
  LOCAL
  REMOTE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IndexingStatus {
  UNPLANNED
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}