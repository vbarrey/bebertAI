generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model PipelineParameters {
  id        Int      @id @default(1)
  parameters    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Better Auth tables (src/lib/auth.ts): fields named as the library expects them.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Admin plugin: "admin" or "user"; a banned user cannot sign in.
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions      Session[]
  accounts      Account[]
  invitations   Invitation[]

  // Their owner's only. Restrict: removing an account must first delete its documents' files and vectors.
  projects      Project[]
  conversations Conversation[]
  documents     Document[]
}

// Accounts are created from an invitation link sent by email (src/lib/invitations.ts).
model Invitation {
  id          String    @id @default(cuid())
  email       String
  // Role of the account created from it.
  role        String    @default("user")
  // sha256 of the token in the link: the token itself is not stored.
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  // Null for the first admin's invitation, created at start-up.
  invitedById String?
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
}

model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One per sign-in method; the password hash lives in the "credential" one.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Password reset tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Rate limit counters, in the database to survive restarts.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Project {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Unique for its owner.
  name              String
  description       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  conversations     Conversation[]

  // Where its conversations search: the whole library, or the documents selected in it. Its own documents always.
  documentScope     DocumentScope  @default(ALL)
  // Library documents selected for the project.
  documents         ProjectDocument[]
  // Documents imported for the project only: out of the library and of the other projects.
  ownedDocuments    Document[]     @relation("OwnedDocuments")

  @@unique([userId, name])
}

enum DocumentScope {
  ALL
  SELECTION
}

model ProjectDocument {
  projectId  String
  documentId String
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([projectId, documentId])
  @@index([documentId])
}

model Conversation {
  id                String    @id @default(cuid())
  // The owner of its project too.
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Null: a conversation outside any project, on the whole library.
  projectId         String?
  title             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages          Message[]
  lastMessageAt     DateTime @default(now())

  modelId String?
  model   AIModel? @relation(fields: [modelId], references: [id])

  @@index([projectId, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String

  role              MessageRole
  status            MessageStatus @default(COMPLETED)

  content           String
  // Assistant only: ChatSource[] of the document excerpts the answer was generated from.
  sources           Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum DocumentSourceType {
  LOCAL
  GOOGLE_DRIVE
  DROPBOX
}

model Document {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName    String
  format         String
  fileSize       Int?
  // Unique in its owner's documents: two users can import the same file.
  checksum       String
  language       String?

  sourceType  DocumentSourceType
  sourceRef   String?
  storagePath String?

  indexedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  indexingStatus IndexingStatus @default(UNPLANNED)

  // Null: a library document. Else imported for this project only; back to the library if the project goes.
  ownerProjectId String?
  ownerProject   Project?       @relation("OwnedDocuments", fields: [ownerProjectId], references: [id], onDelete: SetNull)
  // The projects that selected it.
  projects       ProjectDocument[]

  chunks         Chunk[]
  indexingJobs   IndexingJob[]

  @@unique([userId, checksum])
  @@index([displayName])
  @@index([ownerProjectId])
}

model Chunk {
  id         String @id @default(cuid())
  documentId String

  position   Int
  text       String

  pageNumber Int?
  // BM25 language of the chunk, else of its document; null: neither could be detected, BM25 without stemmer.
  language   String?
  x          Float?
  y          Float?
  width      Float?
  height     Float?

  document Document @relation( fields: [documentId], references: [id], onDelete: Cascade )

  @@index([documentId, position])
}

// Embeddings by sha256 of model name and chunk text: a reindex that keeps the text skips the embedding model.
// Entries of texts no longer indexed stay: about 10 KB each.
model EmbeddingCache {
  key       String   @id
  // Float32 little-endian.
  embedding Bytes
  createdAt DateTime @default(now())
}

// The Google account connected for the Drive import, a single one. Tokens are encrypted (GOOGLE_TOKEN_ENCRYPTION_KEY).
model GoogleDriveConnection {
  id           Int      @id @default(1)
  email        String
  refreshToken String
  accessToken  String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IndexingJob {
  id         String   @id @default(cuid())
  documentId String

  status       JobStatus @default(QUEUED)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt   DateTime  @default(now())

  document Document @relation( fields: [documentId], references: [id], onDelete: Cascade )

  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

model AIProvider {
  id        String @id @default(cuid())

  name      String
  type      AIProviderType
  // Where the provider runs its models: its models are local or remote with it.
  source    AIProviderSource

  enabled   Boolean @default(true)
  isDefault Boolean @default(false)

  configuration Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models        AIModel[] @relation("ProviderModels")

  defaultModelId String?
  defaultModel AIModel? @relation("DefaultModel", fields: [defaultModelId], references: [id])
}

model AIModel {
  id String @id @default(cuid())

  providerId String
  provider AIProvider @relation("ProviderModels", fields: [providerId], references: [id], onDelete: Cascade)

  defaultForProviders AIProvider[] @relation("DefaultModel")

  name String
  displayName String?
  description String?

  enabled Boolean @default(true)
  favorite Boolean @default(false)

  sizeBytes BigInt?
  parameterSize String?
  family String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Remote model refused without usage credits (Ollama Cloud answers 402); null when unknown or local.
  requiresCredits Boolean?

  conversations Conversation[]

  capabilities AIModelCapability[]

  @@unique([providerId, name])
}

model AIModelCapability {
  id String @id @default(cuid())
  name Capability @unique

  models AIModel[]
}

enum Capability {
  GENERATION
  EMBEDDING
  RERANKING
}

enum AIProviderType {
  OLLAMA_LOCAL
  OLLAMA_CLOUD
  VOYAGE
  GOOGLE
  OPENAI
  ANTHROPIC
}

enum AIProviderSource {
  LOCAL
  REMOTE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum IndexingStatus {
  UNPLANNED
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
  // Indexed with pipeline parameters changed since: its vectors were deleted.
  NEEDREINDEX
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  // Stopped by the user: the answer is kept as far as it went.
  CANCELLED
}