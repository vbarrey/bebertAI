# Copy to .env. With docker compose, the service addresses (database, Redis, Qdrant, storage)
# are set in docker-compose.yml: only the authentication and Google Drive values are needed here.

# --- Address ---
# The domain the app is reached at, pointing to the server (Caddy gets its HTTPS certificate). localhost for a test.
DOMAIN=localhost

# --- Authentication ---
# Required in production, 32 characters or more: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public address of the app, used in the links of the emails: https://<DOMAIN> in production.
APP_URL=http://localhost:3000
# Without any account yet, each start-up sends this address an invitation to create the first admin.
ADMIN_EMAIL=

# --- Services (local run without docker compose) ---
DATABASE_URL=file:./data/database/bebertai.db
DOCUMENTS_STORAGE_PATH=./data/documents
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# --- Load (optional, prudent defaults) ---
# Documents the worker indexes at once.
INDEXING_CONCURRENCY=2

# --- Google Drive import (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://<DOMAIN>/api/google-drive/callback in production, the same in the Google console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback

# --- Emails: invitations and password resets (optional: without SMTP_HOST, they go to the logs) ---
# OVH mailbox (MX Plan, Zimbra): smtp.mail.ovh.net, port 465, the full address as user.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# The sender shown, e.g. Bebert AI <contact@example.fr>; SMTP_USER by default.
EMAIL_FROM=

# --- Encryption of the Google Drive tokens and of the providers' API keys ---
# Required in production, 32 bytes in base64: openssl rand -base64 32 (GOOGLE_TOKEN_ENCRYPTION_KEY, its former name,
# is still read). Never change it: the stored API keys and Drive tokens could no longer be decrypted.
ENCRYPTION_KEY=
