# Copy to .env. With docker compose, the service addresses (database, Ollama, Redis, Qdrant, storage)
# are set in docker-compose.yml: only the authentication and Google Drive values are needed here.

# --- Authentication ---
# Required in production, 32 characters or more: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public address of the app, used in the links of the emails.
APP_URL=http://localhost:3000
# Without any account yet, each start-up sends this address an invitation to create the first admin.
ADMIN_EMAIL=

# --- Services (local run without docker compose) ---
DATABASE_URL=file:./data/database/bebertai.db
DOCUMENTS_STORAGE_PATH=./data/documents
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3:0.6b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# --- Google Drive import (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback
# 32 bytes in base64: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
