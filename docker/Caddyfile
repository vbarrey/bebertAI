# HTTPS in front of the app: Caddy gets and renews the Let's Encrypt certificate of DOMAIN by itself
# (ports 80 and 443 open, DOMAIN pointing to the server). DOMAIN=localhost: a local certificate, for a test.
{$DOMAIN} {
	# Above the app's limit (300 MB per import), which answers with a clear message.
	request_body {
		max_size 310MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		# The chat answers are streamed: sent on as they come, never buffered.
		flush_interval -1
	}
}
