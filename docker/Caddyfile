# HTTPS in front of the app: Caddy gets and renews the Let's Encrypt certificate of DOMAIN by itself
# (ports 80 and 443 open, DOMAIN pointing to the server). DOMAIN=localhost: a local certificate, for a test.
{$DOMAIN} {
	# Above the app's limits, which answer with a clear message: 300 MB per document import, 10 GB per .bebert
	# bundle (src/lib/bundle/limits.ts). Exclusive matchers: both limits would apply to the same request otherwise.
	@bundleImport path /api/bundles/import
	request_body @bundleImport {
		max_size 10GB
	}
	@otherRequests not path /api/bundles/import
	request_body @otherRequests {
		max_size 310MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		# The chat answers are streamed: sent on as they come, never buffered.
		flush_interval -1
	}
}
